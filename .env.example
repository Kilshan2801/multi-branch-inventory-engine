# Copy to .env and fill in real values. Never commit .env.

APP_ENV=development
LOG_LEVEL=INFO

# SQLAlchemy URL (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://inventory:change-me@localhost:5432/inventory

# Used only by the test suite. Must point at a throwaway database: tests wipe it.
TEST_DATABASE_URL=postgresql+psycopg://inventory:change-me@localhost:5432/inventory_test

# At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Password given to every demo user created by scripts/seed.py
SEED_DEFAULT_PASSWORD=replace-with-a-demo-password

# docker-compose only
POSTGRES_USER=inventory
POSTGRES_PASSWORD=change-me
POSTGRES_DB=inventory
